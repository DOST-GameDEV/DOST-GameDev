; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tumbang Preso"
config/description="2v2 arena brawler — Cans vs Tsinelas. Built for Gear Up NCR — Esports Game Dev Challenge."
; Single source of truth for the build version — see scripts/systems/game_version.gd.
; Bump the minor number with every gameplay/UI/model/scene change; shown on screen
; (main menu + in-match HUD) so a new build is visually confirmable.
config/version="1.2"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

