# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_credentials.cfg
# export_presets.cfg is tracked — it holds no secrets and a preset that only
# exists on one machine is not a build process (F-3).
*.translation
.mono/
data_*/
mono_crash.*.json
.nomedia
*.tmp
.vscode/

# Build output — the raw export (.exe/.pck) stays out; it's regenerated locally via
# tools/export.md and the .exe alone (~104MB) exceeds GitHub's 100MB push limit anyway.
# The packaged .zip and its README ARE tracked (see tools/export.md) so teammates can grab
# a runnable build straight from the repo without a Godot install.
build/*
!build/*.zip
!build/README.txt

# OS
.DS_Store
Thumbs.db

# Local agent worktrees and session state
.claude/
# Git worktrees for concurrent agent lanes (docs/Concurrency_Protocol.md)
.worktrees/

# Python bytecode from the dev-time map builders
__pycache__/
