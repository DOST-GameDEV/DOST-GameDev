# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_credentials.cfg
# export_presets.cfg is tracked — it holds no secrets and a preset that only
# exists on one machine is not a build process (F-3).
*.translation
.mono/
data_*/
mono_crash.*.json
.nomedia
*.tmp
.vscode/

# Build output — the raw export (.exe/.pck) stays out; it's regenerated locally via
# tools/export.md and the .exe alone (~104MB) exceeds GitHub's 100MB push limit anyway.
# The packaged .zip and its README ARE tracked (see tools/export.md) so teammates can grab
# a runnable build straight from the repo without a Godot install.
build/*
!build/*.zip
!build/README.txt
# The update manifest. `scripts/systems/update_check.gd` fetches this file from
# `main` to decide whether a running copy is out of date, so it is the one thing
# in here that MUST ship to GitHub — an ignored manifest is an update prompt that
# never fires. Written by `tools/release.py`, never by hand.
!build/latest.json

# OS
.DS_Store
Thumbs.db

# Local agent worktrees and session state
.claude/
# Git worktrees for concurrent agent lanes (docs/Concurrency_Protocol.md)
.worktrees/

# Python bytecode from the dev-time map builders
__pycache__/

# Probe output. `flow_probe` and `hud_probe` default their capture path to `res://`,
# so a run drops PNGs (and Godot then generates an `.import` sidecar for each) into the
# repo root. They are regenerable evidence, never source — and a permanently dirty tree
# is what hides a real uncommitted change on submission day. See Agent_Prompts 4.13/10.3.
/flow_*.png
/flow_*.png.import
/hud_*.png
/hud_*.png.import
/spectator_pov.png
/spectator_pov.png.import
