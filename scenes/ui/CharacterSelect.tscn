; The character used to float on ONE FLAT NAVY FILL — the preview Environment below
; is BG_COLOR, and with an opaque SubViewport nothing behind it could ever show. So
; the SubViewport is now transparent (BG_CLEAR_COLOR + transparent_bg) and this
; gradient is what the figure stands against: cool haze up top, INK at the floor, so
; the dark hair reads against the light end and the pale shoes against the dark one.
; Both ends are UiTheme tokens — INK #040838 and PANEL #E1E5E8 — lerped, matching how
; Gradient_scrim below already spells INK out as a literal.
[sub_resource type="Gradient" id="Gradient_backdrop"]
offsets = PackedFloat32Array(0, 0.55, 1)
colors = PackedColorArray(0.622, 0.638, 0.7, 1, 0.258, 0.274, 0.412, 1, 0.015686, 0.031373, 0.219608, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_backdrop"]
gradient = SubResource("Gradient_backdrop")
width = 8
height = 256
fill_to = Vector2(0, 1)

; A stage light behind the figure, so the backdrop has a centre instead of being a
; flat wash. FILL_RADIAL on a GradientTexture2D — a texture, not a shader. `fill_from`
; is in UV, so it tracks the figure's screen fraction (~0.70 wide, ~0.42 down) as the
; viewport grows rather than sitting at a fixed pixel.
[sub_resource type="Gradient" id="Gradient_glow"]
offsets = PackedFloat32Array(0, 0.45, 1)
colors = PackedColorArray(0.882, 0.898, 0.906, 0.3, 0.882, 0.898, 0.906, 0.13, 0.882, 0.898, 0.906, 0)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_glow"]
gradient = SubResource("Gradient_glow")
width = 256
height = 256
fill = 1
fill_from = Vector2(0.7, 0.42)
fill_to = Vector2(1.15, 0.42)

[sub_resource type="Gradient" id="Gradient_scrim"]
offsets = PackedFloat32Array(0, 0.36, 0.62, 1)
colors = PackedColorArray(0.015686, 0.031373, 0.219608, 0.85, 0.015686, 0.031373, 0.219608, 0.7, 0.015686, 0.031373, 0.219608, 0.12, 0.015686, 0.031373, 0.219608, 0)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_scrim"]
gradient = SubResource("Gradient_scrim")
