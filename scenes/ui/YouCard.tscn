[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/you_card.gd" id="1"]

; ⚠️ 64px OF CLEARANCE UNDER THIS CARD, NOT 16 — 🧑, after seeing the numbers: *"the ui
; huds midgame still go BELOW the screen, could u js make it smaller or dont force it to
; be so down there ... we dont have to do some complicated stuff to fix that man"*. Fair.
;
; The window fix (`game_launch.gd::fit_window_to_usable_screen`) makes the whole content
; rect visible, and this is the belt to that braces: a card whose last row sits 16px off
; the bottom of the frame is one taskbar, one title bar, one overscan-happy TV or one
; borderless-window quirk away from being clipped again, on a machine nobody here owns.
; Everything bottom-anchored in the HUD now keeps out of a 64px band along the bottom
; edge — asserted for every row set by `ui_layout_probe.gd::_report_you_card()` against
; BOTTOM_SAFE_BAND. The card is not smaller; it is 48px higher, which is what "dont force
; it so down there" asks for and costs nothing on screen.
[node name="YouCard" type="Control"]
layout_mode = 3
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -220.0
offset_right = 236.0
offset_bottom = -64.0
mouse_filter = 2
script = ExtResource("1")

; ⚠️ GROWS UP AND RIGHT, NEVER DOWN — 🧑 "pls make sure no ui goes below screen bruh".
;
; A PanelContainer's size is clamped UP to its content minimum and it neither clips
; nor shrinks, so the anchored 220x156 box below is a REQUEST. Measured 2026-07-30 by
; `ui_layout_probe`'s YouCardRows sweep (which switches each role's rows on, because
; four of them ship hidden): the worst real row set is 146px of content in that 156px
; box, so it fits today with 10px of headroom — but the default grow direction on a
; full-rect child is BOTH, and the bottom edge is 16px off the bottom of the screen.
; One extra row, one bigger caption font, or the `Hud*` size ladder UX still owes,
; and the surplus leaves the frame.
;
; `grow_vertical = 0` (BEGIN) pins the bottom edge and sends any growth upward into
; empty screen; `grow_horizontal = 1` (END) sends width rightward instead of off the
; left edge. Neither changes the current layout by a pixel — they change where the
; next 10px goes. Asserted per row set by `ui_layout_probe.gd::_report_you_card()`.
[node name="Card" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 1
grow_vertical = 0
theme_type_variation = &"HudCard"

[node name="VBoxContainer" type="VBoxContainer" parent="Card"]
layout_mode = 2

; ═══ IDENTITY: ONE LINE, NOT THREE ═══
; ⚠️ THIS WAS "YOU" / "ATTACKER" / "P1" ON THREE SEPARATE ROWS. 🧑 2026-08-01:
; *"too ugly, too much stuff happening in that box. confusing"*.
;
; `HeaderLabel` ("YOU") is DELETED outright: it is the only card pinned to the
; player's own corner, it is the only one with the HIGHLIGHT border, and it names
; the player inside it — three things already saying "you" before the word does.
;
; The role and the name are one row now. The role is the hero (it changes every
; round and decides what every other control does); the name is a quiet tail on the
; same line, because it never changes and is only there to confirm which seat you are.
[node name="IdentityRow" type="HBoxContainer" parent="Card/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ClassLabel" type="Label" parent="Card/VBoxContainer/IdentityRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HudCaption"
vertical_alignment = 1
text = "ATTACKER"

[node name="DetailLabel" type="Label" parent="Card/VBoxContainer/IdentityRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"HudBody"
horizontal_alignment = 2
vertical_alignment = 1
text = "P1"

[node name="GuardDashSpacer" type="Control" parent="Card/VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 6)

[node name="GuardDashRow" type="HBoxContainer" parent="Card/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="GuardDashKeyLabel" type="Label" parent="Card/VBoxContainer/GuardDashRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudCaption"
text = "[SHIFT]"

[node name="GuardDashBar" type="ProgressBar" parent="Card/VBoxContainer/GuardDashRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 16)
layout_mode = 2
size_flags_horizontal = 3
show_percentage = false

; ⚠️ `HoldLabel` IS DELETED. It printed "GO GET IT" / "SLIPPER READY" — the same
; instruction the LataCard already gives in the opposite corner ("RETRIEVE A SLIPPER",
; "GET OUT OF THE BOX TO THROW", "HOLD E IN THE RING"), which is most of what made this
; box confusing: two cards answering "what do I do now" with different words.
;
; The split is now clean. THIS card is WHO YOU ARE and WHAT YOU HAVE — role, name,
; stamina, and whichever action meter is live. The LataCard is WHAT TO DO.
[node name="ChargeRow" type="HBoxContainer" parent="Card/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8
visible = false

[node name="ChargeKeyLabel" type="Label" parent="Card/VBoxContainer/ChargeRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudCaption"
text = "[?]"

[node name="ChargeBar" type="ProgressBar" parent="Card/VBoxContainer/ChargeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 16)
layout_mode = 2
size_flags_horizontal = 3
show_percentage = false

[node name="ResetChannelRow" type="HBoxContainer" parent="Card/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8
visible = false

[node name="ResetChannelKeyLabel" type="Label" parent="Card/VBoxContainer/ResetChannelRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudCaption"
text = "RIGHTING LATA"

[node name="ResetChannelBar" type="ProgressBar" parent="Card/VBoxContainer/ResetChannelRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 16)
layout_mode = 2
size_flags_horizontal = 3
show_percentage = false
