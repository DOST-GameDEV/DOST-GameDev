; ═══ PLAYER NAME ═══ § CHECKLIST 1.9.
; ⚠️ AUTHORED HERE RATHER THAN BUILT BY `_build_name_row()`, for the same reason the
; HUD's scoreboard was: a control that exists only at runtime is a control the scene
; cannot describe, cannot be styled with the rest of the panel, and — the part that
; matters — sits OUTSIDE the focus order the .tscn defines. It is first in the list on
; purpose: it is the only row about WHO you are rather than about how the game reads
; your hardware.
[node name="PlayerNameRow" type="HBoxContainer" parent="Card/Margin/Layout/Scroll/Content/BindingsList"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

; ⚠️ `MenuBody` LIKE EVERY OTHER ROW LABEL, AND IT IS WHY THIS ONE LOOKED WRONG. It was
; the only label on the panel with no variation at all, so it fell through to the theme's
; default Label — a different size, a different weight and no outline — sitting directly
; above eleven keycap rows that `settings_panel.gd::_rebuild_bindings()` builds with
; `MenuBody`. 🧑 2026-08-02: *"Username is standing out bcz its the only one that isnt
; caps"*. Not the letter case; the typeface. The rest of this row was already matched to
; the built ones (`_build_name_row()` copies ACTION_LABEL_WIDTH and drops the separation
; override) and only the type was left behind.
;
; ⚠️ THE FLAT WHITE OVERRIDE GOES WITH IT. It predates the Menu* set and was the only
; thing keeping this label legible on the dark wood — the same patch the built rows
; carried until they were moved onto the variation. `MenuBody` supplies the cream and the
; navy outline that the panel is actually designed around, and an override on top of it
; would just reintroduce the odd one out in a new colour.
[node name="PlayerNameLabel" type="Label" parent="Card/Margin/Layout/Scroll/Content/BindingsList/PlayerNameRow"]
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
theme_type_variation = &"MenuBody"
vertical_alignment = 1
text = "Username"

[node name="PlayerNameField" type="LineEdit" parent="Card/Margin/Layout/Scroll/Content/BindingsList/PlayerNameRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
size_flags_horizontal = 3
max_length = 14
; ⚠️ CENTRED, LIKE EVERY OTHER VALUE IN THIS LIST. 🧑 2026-08-04: *"the username
; doesnt start in middle in UI for settings pls fix that it stands out"*. A LineEdit
; defaults to left-aligned while every Button under it centres its label, so one box
; in a column of fourteen put its text hard against the left edge.
alignment = 1
; Empty is legal and means "use the seat label" (Design.md 10), so the placeholder
; shows what you WILL be called rather than nagging you to fill it in.
placeholder_text = "P1"

[node name="MouseHeading" type="Label" parent="Card/Margin/Layout/Scroll/Content"]
